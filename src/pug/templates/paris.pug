article.col-sm-12.col-md-4.col-lg-4.col-xl-4.paris
  div.dateparis.cloudy_sun
    div.dateparis_header
      figure
        img(src="", title="Nublado sol", alt="Nublado sol")
      p.temp
      div.city_info
        p.city Lyon
        p.country Francia
    ul
      li
        p.humidity Humedad 68%
      li
        p.wind-dir Oeste
      li
        p.wind-speed 8.03 km/h
  div.dateparis.cloudy_moon
